{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pixo-ai",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Static site (prerendered public pages) is served by Workers Static Assets.
  // Only /api/* reaches the Worker; everything else is served directly (free, no Worker invocation).
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pixo-db",
      // Replace with the real id after `wrangler d1 create pixo-db` (see docs/DEPLOY.md).
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "APP_ENV": "development",
    "SITE_URL": "https://pixo.tr",
    // Public Turnstile site key. The default is Cloudflare's official "always passes" TEST key.
    // Replace it in production with your own site key (it is public, not a secret).
    "TURNSTILE_SITE_KEY": "1x00000000000000000000AA"
  }
  // Secrets (never commit): TURNSTILE_SECRET_KEY, IP_HASH_SALT
  // Set with: wrangler secret put TURNSTILE_SECRET_KEY
}
