{
  "name": "pixo-ai",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Pixo AI — AI-powered marketing creation platform (pixo.tr)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler dev",
    "build": "npm run build:client && npm run build:ssr && node scripts/prerender.mjs",
    "build:client": "vite build",
    "build:ssr": "vite build --ssr src/entry-server.tsx --outDir dist-ssr",
    "preview": "npm run build && wrangler dev",
    "typecheck": "wrangler types --include-env=false >/dev/null && tsc -b",
    "test": "vitest run",
    "test:seo": "node scripts/check-build.mjs",
    "test:e2e": "node scripts/e2e-responsive.mjs",
    "check": "npm run typecheck && npm test && npm run build && npm run test:seo",
    "db:migrate:local": "wrangler d1 migrations apply pixo-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply pixo-db --remote",
    "deploy": "npm run check && wrangler deploy"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^7.18.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "playwright": "^1.56.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vite": "^7.3.7",
    "vitest": "^4.1.11",
    "wrangler": "^4.149.0"
  }
}
